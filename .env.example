# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CHATBASE_BOT_ID: Optional Chatbase.io bot ID for custom live widget integration
CHATBASE_BOT_ID=""

# ADMIN_PASSWORD: Password for Powershine Tech Admin Enquiry Portal
ADMIN_PASSWORD="powershine_admin_2026"

# SMTP & EMAIL NOTIFICATION CONFIGURATION
ADMIN_EMAIL="powershine07@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

